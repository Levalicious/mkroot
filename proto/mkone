#
# mkone - build a single program from object files
#
# expects: TARG, OFILES, possibly HFILES and LIBFILES
# LIBFILES are the archives the program links, each a real prerequisite: the including mkfile gives every one a rule
# that builds it in its own directory from that directory's sources, so that it is rebuilt when they change and made
# from a clean tree. The variables go before the include, the rule after it (mk's default target is the first rule's,
# which must stay all):
#     LIBEEZO=../libeezo/libeezo.a
#     LIBFILES=$LIBEEZO
#     <$MKROOT/proto/mkone
#     $LIBEEZO: `ls ../libeezo/*.[ch]`
#         cd ../libeezo && mk libeezo.a
# Header dependencies are HFILES (list the library headers the sources include), include paths are CFLAGS (-I..).
PROG=$TARG

all:V: $PROG

$PROG: $OFILES $LIBFILES
	$LD -o $target $OFILES $LDFLAGS $LIBFILES

%.$O: %.c
	$CC $CFLAGS -c $stem.c -o $stem.$O

%.$O: $HFILES

install:V: $PROG
	mkdir -p $PREFIX/bin
	cp $PROG $PREFIX/bin/$TARG
	chmod 755 $PREFIX/bin/$TARG

clean:V:
	rm -f $OFILES $PROG

nuke:V: clean
