#
# mklib - build a library from object files
#
# expects: LIB, OFILES, possibly HFILES

all:V: $LIB

# the archive is made afresh from $OFILES: ar only replaces and adds members, so updating it in place kept the
# member of a source that had gone (a stale res.o doubled its symbols in libeezo, 2026-09-29)
$LIB: $OFILES
	rm -f $target
	$AR $ARFLAGS $target $prereq
	$RANLIB $target

%.$O: %.c
	$CC $CFLAGS -c $stem.c -o $stem.$O

%.$O: $HFILES

install:V: $LIB
	mkdir -p $PREFIX/lib
	cp $LIB $PREFIX/lib/
	chmod 644 $PREFIX/lib/$LIB

clean:V:
	rm -f $OFILES $LIB

nuke:V: clean
